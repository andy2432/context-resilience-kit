{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/context-resilience/work-state.schema.json",
  "title": "Work State",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "tasks"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "blocker": {
      "type": "object",
      "required": ["reason", "owner", "nextCheck"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "nextCheck": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "owner",
        "threadId",
        "branch",
        "baseSha",
        "scope",
        "forbidden",
        "acceptance",
        "nextAction",
        "blockers",
        "evidence",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "active",
            "accepted",
            "ready_for_review",
            "blocked",
            "waiting_external",
            "unverified"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": ["string", "null"]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
